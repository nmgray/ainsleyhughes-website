# Server-only destination for contact and valuation submissions
LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/replace/me
# Optional bearer token sent to the configured webhook
LEAD_WEBHOOK_SECRET=replace-me
# Required for POST requests to /api/llm-tools
LLM_TOOLS_API_KEY=replace-with-a-long-random-value
# Content editor login: generate with npm run admin:hash-password
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-salt$replace-with-generated-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Use /data paths in production with the Fly volume configured in fly.toml
CONTENT_DB_PATH=data/content.sqlite
CONTENT_UPLOAD_DIR=data/uploads
# Optional shared limiter for multi-instance deployments
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
