# Required in production for contact and valuation submissions: an HTTPS endpoint that delivers inquiries by email
LEAD_WEBHOOK_URL=https://your-email-delivery-service.example/inquiries
# Optional bearer token sent to the lead-delivery endpoint
LEAD_WEBHOOK_SECRET=replace-me

# Legacy POST /api/llm-tools lead endpoint; not used by ChatGPT publishing
LLM_TOOLS_API_KEY=replace-with-a-long-random-value

# Local paths only; fly.toml sets /data paths on the persistent Fly volume
CONTENT_DB_PATH=data/content.sqlite
CONTENT_UPLOAD_DIR=data/uploads

# Fly app secret for the ChatGPT publishing Action; use a different 32+ character key per app
# Configure the matching key in the GPT Action's authentication settings, never in its instructions
EDITOR_API_KEY=replace-with-a-random-editorial-key-of-at-least-32-characters

# Optional shared rate limiter; single-Machine Fly deployments use a local limiter
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# GitHub Actions uses FLY_API_TOKEN in the separate test and production GitHub environments.
# It is an app-scoped Fly deploy token, not a runtime variable or a ChatGPT Action key.
